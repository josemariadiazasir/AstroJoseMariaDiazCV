      "Gestión de redes.",
    ],
  },
];
---

<div class="max-w-2xl mx-auto">
  {jobs.map((job, i) => (
    <ExperienceItem
      company={job.company}
      role={job.role}
      period={job.period}
      location={job.location}
      bullets={job.bullets}
      current={job.current}
      isLast={i === jobs.length - 1}
    />
  ))}
</div>
